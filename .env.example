# Bulla environment template. Copy to .env (gitignored). NEVER commit .env.
# Sources for every value: docs/research.md

# --- Network used by scripts/probe-*.ts ---------------------------------
# X Layer mainnet: chain 196, RPC https://rpc.xlayer.tech
# X Layer testnet: chain 1952, RPC https://testrpc.xlayer.tech/terigon
X_LAYER_RPC=https://rpc.xlayer.tech
X_LAYER_CHAIN_ID=196
EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer

# Escrow ERC-20. Optional until the mainnet token gate passes (docs/research.md §2).
# Circle USDC on X Layer mainnet: 0xB6CEceAB302E2E4948951eE7843FC24E92933061
# Circle USDC on X Layer testnet: 0xDec90b78111Ba2fc6FC6d84d8B9ec159A2d4b9B3
ESCROW_TOKEN=

# BullaEscrow address. Empty until a human deploys.
ESCROW_ADDRESS=

# Optional: an address whose token balance probe-network prints.
PROBE_ACCOUNT=

# --- Deploy (contracts/scripts/deploy-xlayer.ts) -------------------------
FEE_RECIPIENT=
FEE_BPS=50
# Optional RPC overrides used by hardhat.config.ts
X_LAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon
X_LAYER_MAINNET_RPC=https://rpc.xlayer.tech
# A HUMAN supplies this later, locally, never in git. Leave empty here.
DEPLOYER_PRIVATE_KEY=
# Required in addition to the key for mainnet:
# CONFIRM_MAINNET=I_UNDERSTAND_UNAUDITED

# --- TapeOut (scripts/probe-tapeout.ts) ----------------------------------
# Your circuit's processor (circuit NFT contract) and #ID, once minted.
TAPEOUT_PROCESSOR=
TAPEOUT_CIRCUIT_ID=

# --- Web build (web/, Vite reads VITE_* at build time) -------------------
# localhost | xlayerTestnet | xlayerMainnet
VITE_BULLA_NETWORK=xlayerMainnet
# Optional overrides of contracts/deployments.json
VITE_ESCROW_ADDRESS=
VITE_ESCROW_TOKEN=
VITE_RPC_URL=
# Set to 1 to use the in-browser fixture data (dev only, never for a published build)
VITE_MOCK=0

# --- Judge mode (X Layer TESTNET 1952 only; see docs/HANDOFF.md) ----------
# Judge-mode escrow + DemoUSD are written to contracts/deployments.json by `npm run deploy:judge`.
# Optional overrides:
VITE_JUDGE_ESCROW_ADDRESS=
VITE_JUDGE_TOKEN=
VITE_JUDGE_DEPLOY_BLOCK=
# Mainnet/DeWEB build: link "Try it now" to the hosted testnet judge build.
VITE_JUDGE_URL=https://try-usebulla.vercel.app
# TESTNET-ONLY demo gas tank private key, set ONLY when building the judge build
# (VITE_BULLA_NETWORK=xlayerTestnet). It is embedded in that build, so treat it as public:
# fund it with small faucet amounts only, never reuse it, rotate it if drained.
# A mainnet build refuses to compile if this is set. Never commit a value here.
VITE_DEMO_GAS_TANK_KEY=
# Opt-in testnet acceptance run: E2E_TESTNET=1 npm run e2e:testnet
E2E_TESTNET=
