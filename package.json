{
  "name": "bulla",
  "private": true,
  "version": "0.1.0",
  "description": "Bulla: milestone invoices with on-chain escrow on X Layer",
  "workspaces": ["contracts", "web"],
  "scripts": {
    "compile": "npm run compile -w contracts",
    "test": "npm run test -w contracts",
    "test:contracts": "npm run test -w contracts",
    "build": "npm run build -w web",
    "dev": "npm run dev -w web",
    "node": "npm run node -w contracts",
    "deploy:local": "npm run deploy:local -w contracts",
    "deploy:testnet": "npm run deploy:testnet -w contracts",
    "deploy:mainnet": "npm run deploy:mainnet -w contracts",
    "probe:network": "tsx scripts/probe-network.ts",
    "probe:tapeout": "tsx scripts/probe-tapeout.ts",
    "deweb:package": "npm run build && tsx scripts/deweb-package.ts",
    "e2e:keys": "tsx scripts/gen-test-keys.ts",
    "e2e": "tsx scripts/run-e2e.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "viem": "^2.21.0",
    "dotenv": "^16.4.5",
    "@playwright/test": "1.63.0"
  }
}
